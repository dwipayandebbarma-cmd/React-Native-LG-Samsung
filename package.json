{
  "name": "smart-tv-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start:dev": "cross-env NODE_ENV=development expo start --web --clear",
    "build": "expo export --platform web && node scripts/webos/fix-bundle-path.js",
    "build:dev": "cross-env NODE_ENV=development expo export --platform web && node scripts/webos/fix-bundle-path.js",
    "build:tizen": "npm run build && node scripts/tizen/prepare-tizen.js",
    "build:tizen:sync": "npm run build && TIZEN_SYNC_TARGET=/home/dwipayan/workspace/RNPOC TIZEN_KEEP_CONFIG=1 node scripts/tizen/prepare-tizen.js",
    "build:tv": "npm run build && node scripts/webos/prepare-dist.js && node scripts/android-tv/sync-assets.js",
    "lg": "npm run build:tv && ares-package -n ./dist",
    "demo:lg": "node scripts/demo/lg-emulator.js",
    "demo:lg:simulator": "cross-env WEBOS_DEVICE=simulator node scripts/demo/lg-emulator.js",
    "demo:lg:simulator:fix": "bash scripts/webos/fix-simulator-wrapper.sh",
    "build:android-apk": "bash scripts/android-tv/build-apk.sh",
    "demo:android-tv": "npm run build:tv && cd android-tv && ./gradlew installDebug",
    "demo:browser": "npm run build && node scripts/demo/browser-server.js"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^2.3.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "cross-env": "^7.0.3",
    "expo": "~48.0.21",
    "expo-status-bar": "~1.4.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.71.14",
    "react-native-gesture-handler": "~2.9.0",
    "react-native-safe-area-context": "4.5.0",
    "react-native-screens": "~3.20.0",
    "react-native-web": "~0.18.10",
    "shaka-player": "^4.15.8",
    "expo-linear-gradient": "~12.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
